# ==============================================================================
# NEURO-SYMBOLIC SOCRATIC VIRTUAL TUTOR - ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Application Settings
APP_NAME="Neuro-Symbolic Socratic Virtual Tutor"
APP_ENV="development"
DEBUG=true
PORT=8000
# P0: keep false in production until code runs in an isolated worker (no secrets in env)
ENABLE_CODE_EXECUTION=false

# Database Configuration (Neon Serverless PostgreSQL or SQLite test fallback)
# Example Neon URL: postgresql+psycopg://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="sqlite+aiosqlite:///./socratic_tutor.db"
TEST_DATABASE_URL="sqlite+aiosqlite:///./test_socratic_tutor.db"

# Hybrid Authentication (Local JWT + Google OAuth2)
JWT_SECRET_KEY="CHANGE_ME_IN_PRODUCTION_USE_STRONG_256_BIT_SECRET"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Google OAuth 2.0 Web Client ID (Google Cloud Console → APIs & Services → Credentials)
# Authorized JavaScript origins must include: http://localhost:5173
# Authorized redirect URIs can be left empty for GIS popup / button flows.
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# Google Cloud Vertex AI Configuration (Official google-genai SDK; NO google_search grounding)
# Authenticate locally via: gcloud auth application-default login
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
GOOGLE_CLOUD_LOCATION="us-central1"
# Optional fallback only if GOOGLE_GENAI_USE_VERTEXAI=false
GEMINI_API_KEY=""

# Locked 4-Model Gemini Cascade & Embeddings
GEMINI_PRIMARY_MODEL="gemini-3.1-flash-lite"
GEMINI_SECONDARY_MODEL="gemini-3.5-flash-lite"
GEMINI_TERTIARY_MODEL="gemini-3.7-flash"
GEMINI_EMERGENCY_MODEL="gemini-2.5-flash-lite"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
GEMINI_EMBEDDING_DIM=768

# Socratic Loop & Symbolic Verification Guardrails
MAX_SOCRATIC_RETRIES=3
RAG_SIMILARITY_THRESHOLD=0.65
RAG_MAX_PDF_PAGES=15
RAG_MAX_PDF_BYTES=5242880
AST_SANDBOX_TIMEOUT_SECONDS=2.0

# Round 2: API budget limits (persisted in rate_limit_buckets; Cloud Run safe)
TURNS_PER_USER_PER_HOUR=20
TURNS_PER_USER_PER_DAY=100
UPLOADS_PER_USER_PER_DAY=5
GLOBAL_TURNS_PER_DAY=1000
REGISTRATIONS_PER_IP_PER_DAY=10
ALLOW_PUBLIC_REGISTRATION=true

# Frontend CORS Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
